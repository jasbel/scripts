# Copia este archivo a .env y rellena con tus datos de Gmail.
#
# Pasos para obtener EMAIL_APP_PASSWORD (contraseña de aplicacion):
#  1. Activa verificacion en 2 pasos: https://myaccount.google.com/security
#  2. Crea una contraseña de aplicacion: https://myaccount.google.com/apppasswords
#     (Elige "Correo" > "Otra" > nombrela p.ej. "email-dev")
#  3. Pegar aqui los 16 caracteres (con o sin espacios).

# Email principal que envia los reportes (SMTP_USER = From)
EMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicacion de Gmail (App Password) - NO la contraseña normal
EMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Destinatario principal
EMAIL_TO=tu_correo@gmail.com

# Destinatarios en copia (separados por coma) - opcional
EMAIL_CC=otro@correo.com, tercero@correo.com

# Asunto del email de prueba (opcional)
EMAIL_SUBJECT=TEST - Email SoloCruceros

# --- SMTP (opcional, por defecto Gmail) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Plantillas solocruceros (repo PHP externo) ---
# Ruta al directorio de templates "default" del repo Symfony. Obligatoria en
# Windows (el default es una ruta Linux). Ejemplos:
#   Windows: SOLOCRUCEROS_TEMPLATES_DIR=C:\Users\Rene\projects\symfony-sites\sites\solocruceros.com\DDD\4.2MainModule\SoloCrucerosDomain.MainModule\DomainServices\resources\templates\default
#   Linux:   SOLOCRUCEROS_TEMPLATES_DIR=/home/asbel/projects/symfony-sites/sites/solocruceros.com/DDD/4.2MainModule/SoloCrucerosDomain.MainModule/DomainServices/resources/templates/default
SOLOCRUCEROS_TEMPLATES_DIR=/home/asbel/projects/symfony-sites/sites/solocruceros.com/DDD/4.2MainModule/SoloCrucerosDomain.MainModule/DomainServices/resources/templates/default

# --- Plantillas Odoo (opcional) ---
# Raiz del proyecto de plantillas Odoo. Por defecto: ./templates/odoo de este repo.
# Para usar el repo externo (componentes en src/template + build a templates/):
#   ODOO_TEMPLATES_DIR=/home/asbel/projects/templates/odoo-email-templates
ODOO_TEMPLATES_DIR=/home/asbel/projects/templates/odoo-email-templates

# --- Figma (opcional) ---
# Personal access token (Figma > Settings > Security) para extraer specs de disenos
# via API REST. Se usa en lectura: GET /v1/files/{key}/nodes?ids=...
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

